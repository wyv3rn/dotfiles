#!/usr/bin/env bash

function filter() {
    if [ -d $1 ]; then
        echo $1
    fi
}

date=$(date +%Y-%m-%d)

config=~/.config/backup/dirs
if [ ! -f $config ]; then
    echo "Backup config not found"
    exit -1
fi

mapfile -t all_dirs < $config

cd $HOME
dirs=""
for d in ${all_dirs[@]}; do
    dirs+=$(filter $d)
    dirs+=" "
done

hostname=$(hostname)
remote="tau-at-home"
tar_cmd="tar -cvzf - $dirs"
backup_dir="/srv/bak/"
backup_name="${hostname}-${date}.tar.gz"

if [ "${hostname}" == "tau" ]; then
    $tar_cmd | cat > ${backup_dir}/${backup_name}
else
    $tar_cmd | ssh $remote "cat > ${backup_dir}/${backup_name}"
fi

cd - >/dev/null 2>&1
